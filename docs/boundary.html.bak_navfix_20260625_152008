<script>
async function fetchJSON(u){try{const r=await fetch(u);if(!r.ok)throw new Error(r.status);return await r.json()}catch(e){return null}}

const FALLBACK_NODES=[
{word:'netanyahu',retention:0.647,era:'pre',stories:57},
{word:'khamenei',retention:0.659,era:'pre',stories:13},
{word:'putin',retention:0.610,era:'pre',stories:41},
{word:'modi',retention:0.618,era:'pre',stories:16},
{word:'xi',retention:0.575,era:'pre',stories:44},
{word:'trump',retention:0.586,era:'pre',stories:613},
{word:'biden',retention:0.635,era:'pre',stories:8},
{word:'zelensky',retention:0.569,era:'pre',stories:13},
{word:'pezeshkian',retention:0.481,era:'post',stories:20},
{word:'araghchi',retention:0.462,era:'post',stories:44},
{word:'baghaei',retention:0.435,era:'post',stories:20},
{word:'hegseth',retention:0.544,era:'post',stories:36},
{word:'vance',retention:0.527,era:'post',stories:32},
{word:'witkoff',retention:0.516,era:'post',stories:12}
];

function drawMap(nodes){
const svg=d3.select('#boundary-map');svg.selectAll('*').remove();
const container=svg.node().parentElement,W=container.clientWidth,H=Math.max(380,Math.min(W*0.62,520));
svg.attr('width',W).attr('height',H).attr('viewBox',`0 0 ${W} ${H}`);
const m={top:26,right:30,bottom:46,left:60},w=W-m.left-m.right,h=H-m.top-m.bottom;
const g=svg.append('g').attr('transform',`translate(${m.left},${m.top})`);
const eraX={pre:w*0.27,post:w*0.73};
const yS=d3.scaleLinear().domain([0.40,0.70]).range([h,0]);
const rS=d3.scaleSqrt().domain([0,d3.max(nodes,d=>d.stories)]).range([6,24]);
[0.45,0.50,0.55,0.60,0.65].forEach(v=>{g.append('line').attr('x1',0).attr('x2',w).attr('y1',yS(v)).attr('y2',yS(v)).attr('stroke','#16161c');});
const preMean=d3.mean(nodes.filter(d=>d.era==='pre'),d=>d.retention);
const postMean=d3.mean(nodes.filter(d=>d.era==='post'),d=>d.retention);
g.append('line').attr('x1',eraX.pre-70).attr('x2',eraX.pre+70).attr('y1',yS(preMean)).attr('y2',yS(preMean)).attr('stroke','#3a8').attr('stroke-dasharray','4,3').attr('opacity',.7);
g.append('line').attr('x1',eraX.post-70).attr('x2',eraX.post+70).attr('y1',yS(postMean)).attr('y2',yS(postMean)).attr('stroke','#d44').attr('stroke-dasharray','4,3').attr('opacity',.7);
g.append('text').attr('x',eraX.pre).attr('y',yS(preMean)-8).attr('text-anchor','middle').attr('fill','#3a8').attr('font-size','9px').attr('font-family','JetBrains Mono').attr('opacity',.8).text('avg '+preMean.toFixed(2));
g.append('text').attr('x',eraX.post).attr('y',yS(postMean)+16).attr('text-anchor','middle').attr('fill','#d44').attr('font-size','9px').attr('font-family','JetBrains Mono').attr('opacity',.8).text('avg '+postMean.toFixed(2));
const seed=nodes.map((d,i)=>({...d,jx:eraX[d.era]+(((i*43)%70)-35)}));
g.append('g').attr('transform',`translate(0,${h})`).call(d3.axisBottom(d3.scaleOrdinal().domain(['pre','post']).range([eraX.pre,eraX.post])).tickFormat(d=>d==='pre'?'Established':'Post-cutoff')).selectAll('text').attr('fill','#8a8a96').attr('font-size','11px').attr('font-family','JetBrains Mono');
g.selectAll('.domain,.tick line').attr('stroke','#3a3a44');
g.append('g').call(d3.axisLeft(yS).ticks(6).tickFormat(d3.format('.2f'))).selectAll('text').attr('fill','#6b6b78').attr('font-size','9px').attr('font-family','JetBrains Mono');
g.selectAll('.domain,.tick line').attr('stroke','#3a3a44');
svg.append('text').attr('x',16).attr('y',H/2).attr('transform',`rotate(-90,16,${H/2})`).attr('text-anchor','middle').attr('fill','#6b6b78').attr('font-size','9px').attr('font-family','JetBrains Mono').text('meaning survives  →');
const tt=d3.select('#tooltip');
g.selectAll('circle').data(seed).enter().append('circle')
.attr('cx',d=>d.jx).attr('cy',d=>yS(d.retention)).attr('r',d=>rS(d.stories))
.attr('fill',d=>d.era==='pre'?'#3a8':'#d44').attr('fill-opacity',.6)
.attr('stroke',d=>d.era==='pre'?'#3a8':'#d44').attr('stroke-opacity',.45)
.style('cursor','pointer')
.on('mouseover',function(e,d){d3.select(this).attr('fill-opacity',1).attr('stroke-width',2);tt.style('opacity',1).html(`<div class="word">${d.word}</div><div class="stat">retention ${d.retention.toFixed(3)}</div><div class="stat">${d.era==='pre'?'established before cutoff':'rose at/after cutoff'}</div><div class="stat">across ${d.stories} stories</div>`);const r=container.getBoundingClientRect();tt.style('left',Math.min(e.clientX-r.left+15,W-215)+'px').style('top',Math.max(e.clientY-r.top-10,5)+'px')})
.on('mouseout',function(){d3.select(this).attr('fill-opacity',.6).attr('stroke-width',1);tt.style('opacity',0)});
g.selectAll('.lbl').data(seed.filter(d=>['pezeshkian','netanyahu','hegseth','trump','khamenei'].includes(d.word))).enter().append('text')
.attr('x',d=>d.jx+rS(d.stories)+4).attr('y',d=>yS(d.retention)+3).attr('fill','#7a7a86').attr('font-size','8.5px').attr('font-family','JetBrains Mono').text(d=>d.word);
window.__nodes=nodes;
}

async function init(){
const live=await fetchJSON('/cutoff_retention.json');
drawMap((live&&Array.isArray(live)&&live.length)?live:FALLBACK_NODES);
const panel=document.getElementById('info-panel');
const cards=[
{n:'1,592',l:'Stories in the semantic corpus tests'},
{n:'106,412',l:'Source terms scored for retention'},
{n:'5',l:'Frontier models measured'},
{n:'0',l:'Models judging other models in the stack'}
];
panel.innerHTML=cards.map(c=>`<div class="info-card"><div class="n">${c.n}</div><div class="l">${c.l}</div></div>`).join('');
}
init();
window.addEventListener('resize',()=>{if(window.__nodes)drawMap(window.__nodes);});
</script>
</body>
