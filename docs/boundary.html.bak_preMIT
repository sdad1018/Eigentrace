<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Boundary — EigenTrace</title>
<meta name="description" content="Four word sets. Two raycasts. The complete topology of what five frontier models convergently compress from news summaries.">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Instrument+Serif:ital@0;1&display=swap');
:root{--bg:#0a0a0c;--bg2:#111115;--surface:#18181d;--border:#2a2a32;--text:#e8e6e3;--dim:#6b6b78;--accent:#c4a35a;--set1:#d45a5a;--set2:#d4845a;--set3:#5a7fd4;--set4:#5ad4c4;--void-red:#d44;--kept-green:#3a8;--claude:#d4845a;--chatgpt:#74aa9c;--deepseek:#5a7fd4;--grok:#b45ad4;--gemini:#5ad4a3}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:'JetBrains Mono',monospace;min-height:100vh;overflow-x:hidden}
nav{padding:1.2rem 2rem;font-size:.8rem;border-bottom:1px solid var(--border)}
nav a{color:var(--dim);text-decoration:none;margin-right:1.8rem;transition:color .2s}
nav a:hover{color:var(--accent)}
.hero{text-align:center;padding:4rem 2rem 2rem;position:relative}
.hero::after{content:'';position:absolute;bottom:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent)}
.hero h1{font-family:'Instrument Serif',serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:400;color:var(--text);margin-bottom:.5rem;letter-spacing:-.02em}
.hero h1 em{font-style:italic;color:var(--accent)}
.hero .sub{color:var(--dim);font-size:.75rem;max-width:600px;margin:0 auto;line-height:1.7;letter-spacing:.05em}
.headline-stat{text-align:center;padding:2.5rem 2rem 1.5rem}
.headline-stat .number{font-family:'Instrument Serif',serif;font-size:3rem;color:var(--accent)}
.headline-stat .label{font-size:.72rem;color:var(--dim);max-width:500px;margin:.5rem auto 0;line-height:1.6}
.map-container{width:100%;max-width:1100px;margin:2rem auto;padding:0 1rem;position:relative}
.map-container svg{width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:4px}
.map-title{font-family:'Instrument Serif',serif;font-size:1.3rem;text-align:center;margin-bottom:.5rem;color:var(--text)}
.map-sub{font-size:.7rem;text-align:center;color:var(--dim);margin-bottom:1rem}
#tooltip{position:absolute;pointer-events:none;background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:.8rem;font-size:.75rem;opacity:0;transition:opacity .15s;z-index:10;max-width:250px}
#tooltip .word{color:var(--accent);font-weight:700;font-size:.85rem;margin-bottom:.3rem}
#tooltip .stat{color:var(--dim);line-height:1.5}
.section-title{font-family:'Instrument Serif',serif;font-size:1.8rem;text-align:center;margin:3rem 0 .5rem;font-weight:400}
.section-sub{font-size:.72rem;text-align:center;color:var(--dim);margin-bottom:2rem}
.quad-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;max-width:1000px;margin:0 auto 3rem;background:var(--border);border:1px solid var(--border)}
@media(max-width:700px){.quad-grid{grid-template-columns:1fr}}
.set-card{background:var(--bg);padding:2.5rem 2rem;position:relative}
.set-card::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%}
.set-card:nth-child(1)::before{background:var(--set1)}.set-card:nth-child(2)::before{background:var(--set2)}.set-card:nth-child(3)::before{background:var(--set3)}.set-card:nth-child(4)::before{background:var(--set4)}
.set-num{font-size:.6rem;text-transform:uppercase;letter-spacing:.15em;margin-bottom:.5rem}
.set-card:nth-child(1) .set-num{color:var(--set1)}.set-card:nth-child(2) .set-num{color:var(--set2)}.set-card:nth-child(3) .set-num{color:var(--set3)}.set-card:nth-child(4) .set-num{color:var(--set4)}
.set-name{font-family:'Instrument Serif',serif;font-size:1.4rem;font-weight:400;margin-bottom:.8rem;color:var(--text)}
.set-desc{font-size:.78rem;color:var(--dim);line-height:1.7;margin-bottom:1rem}
.set-method{font-size:.68rem;color:var(--dim);padding:.5rem .7rem;background:var(--bg2);border-radius:3px;border-left:2px solid var(--border);margin-bottom:1rem}
.set-example{font-size:.75rem;margin-top:.8rem}
.set-example .label{font-size:.6rem;color:var(--dim);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.3rem}
.set-example .words{color:var(--accent);line-height:1.6}
.null-test{max-width:800px;margin:0 auto 3rem;padding:0 2rem}
.null-test h2{font-family:'Instrument Serif',serif;font-size:1.8rem;margin-bottom:1rem;font-weight:400}
.null-bar{display:flex;align-items:center;gap:1rem;margin-bottom:1rem;padding:.8rem 1rem;background:var(--surface);border-radius:4px;border:1px solid var(--border)}
.null-bar .bar-label{font-size:.72rem;color:var(--dim);min-width:140px}
.null-bar .bar-track{flex:1;height:6px;background:var(--bg2);border-radius:3px;overflow:hidden}
.null-bar .bar-fill{height:100%;border-radius:3px}
.null-bar .bar-value{font-size:.8rem;font-weight:700;min-width:50px;text-align:right}
.null-note{font-size:.78rem;color:var(--dim);line-height:1.8;margin-top:1rem}
.null-note strong{color:var(--text)}
.live-example{max-width:800px;margin:0 auto 3rem;padding:2rem;background:var(--surface);border:1px solid var(--border);border-radius:6px}
.live-example h3{font-family:'Instrument Serif',serif;font-size:1.3rem;font-weight:400;margin-bottom:.3rem}
.live-example .story-title{font-size:.82rem;color:var(--accent);margin-bottom:1.5rem;font-style:italic}
.live-example .set-row{display:flex;gap:.8rem;align-items:flex-start;margin-bottom:1.2rem;padding-bottom:1.2rem;border-bottom:1px solid var(--border)}
.live-example .set-row:last-child{border-bottom:none}
.set-badge{font-size:.55rem;padding:.2rem .45rem;border-radius:2px;white-space:nowrap;min-width:44px;text-align:center;font-weight:700}
.set-badge.b1{background:var(--set1);color:#000}.set-badge.b2{background:var(--set2);color:#000}.set-badge.b3{background:var(--set3);color:#000}.set-badge.b4{background:var(--set4);color:#000}
.set-content{font-size:.78rem;line-height:1.6}
.set-content .words{color:var(--text)}
.set-content .explain{color:var(--dim);font-size:.72rem;margin-top:.3rem}
#info-panel{max-width:1000px;margin:0 auto 3rem;padding:0 2rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:700px){#info-panel{grid-template-columns:1fr}}
.info-card{background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:1.2rem}
.info-card .label{font-size:.6rem;color:var(--dim);text-transform:uppercase;letter-spacing:.12em;margin-bottom:.3rem}
.info-card .value{font-family:'Instrument Serif',serif;font-size:2rem;color:var(--accent)}
.info-card .desc{font-size:.7rem;color:var(--dim);line-height:1.6;margin-top:.3rem}
.model-row{display:flex;align-items:center;gap:.5rem;margin:.4rem 0}
.model-name{font-size:.7rem;min-width:70px}
.model-bar-bg{flex:1;height:4px;background:var(--bg2);border-radius:2px;overflow:hidden}
.model-bar-fill{height:100%;border-radius:2px}
.model-vix{font-size:.7rem;color:var(--dim);min-width:30px;text-align:right}
.concept-class{margin:.5rem 0}
.class-name{font-size:.72rem;color:var(--accent);margin-bottom:.2rem}
.class-words{display:flex;flex-wrap:wrap;gap:.3rem}
.class-words span{font-size:.65rem;background:var(--bg2);padding:.15rem .4rem;border-radius:2px;color:var(--dim)}
.prose{max-width:700px;margin:0 auto 3rem;padding:0 2rem}
.prose h2{font-family:'Instrument Serif',serif;font-size:1.8rem;margin-bottom:1rem;font-weight:400}
.prose h3{font-size:.85rem;color:var(--accent);margin:2rem 0 .5rem}
.prose p{font-size:.82rem;color:var(--dim);line-height:1.8;margin-bottom:1rem}
.prose strong{color:var(--text)}
.prose code{font-size:.78rem;background:var(--bg2);padding:.1rem .35rem;border-radius:2px;color:var(--accent)}
footer{text-align:center;padding:3rem 2rem;font-size:.68rem;color:var(--dim);border-top:1px solid var(--border)}
footer a{color:var(--dim);text-decoration:none}
footer a:hover{color:var(--accent)}
</style>
</head>
<body>
<nav>
<a href="/">EigenTrace</a>
<a href="/anamnesis">Anamnesis</a>
<a href="/boundary" style="color:var(--accent)">Boundary</a>
<a href="/truth-or-consequences">Layer 18</a>
<a href="/consequence-atlas">Atlas</a>
<a href="/soul">Soul</a>
<a href="/sean-adams">About</a>
</nav>
<div class="hero">
<h1>The <em>Boundary</em></h1>
<p class="sub">Four word sets. Two raycasts. How five frontier models' summaries diverge in framing the same news — and what that divergence reveals.</p>
</div>
<div class="headline-stat">
<div class="number">p = 0.0085</div>
<div class="label">A pre-registered entity-swap counterfactual. The same sentence — same modifier ("quietly," "secretly"), same structure, a real documented incident on each side — retains the consequential modifier measurably less when the actor is an AI developer than a non-AI corporation (semantic retention 0.522 vs 0.545, Cohen's d = 0.47). A within-category null shows almost no gap (0.004), while the cross-category gap is more than six times larger (0.023) — the AI-vs-corporate distinction is the variable, not entity-swapping itself. The effect is corpus-inherited, not RLHF-created (p = 0.46 between heavy-RLHF and lightly-tuned models). <a href="/truth-or-consequences" style="color:var(--accent)">Full methodology →</a></div>
</div>

<div class="map-container">
<div class="map-title">Void Word Topology</div>
<div class="map-sub">Each dot is a convergently absent word. X = category spread. Y = frequency. Size = story count. Color = intensity.</div>
<svg id="boundary-map"></svg>
<div id="tooltip"></div>
</div>

<div class="section-title">Four Word Sets</div>
<div class="section-sub">Two observable. Two geometric. Each measured independently with frozen embeddings.</div>
<div class="quad-grid">
<div class="set-card">
<div class="set-num">Set 1 — Observable</div>
<div class="set-name">Absent Words</div>
<div class="set-desc">Words in the source article absent from every model response. One model dropping a word is compression. Five independently dropping the same string is a surface signal — but because models paraphrase, an absent word may be a reworded meaning rather than a dropped one. This is the weakest of the four sets; the semantic tests carry the real weight.</div>
<div class="set-method">Method: set(source_words) − set(all_model_words). No embeddings. No LLM. Arithmetic.</div>
<div class="set-example"><div class="label">Gaza strikes</div><div class="words">devastated · published · agency · building · economy</div></div>
</div>
<div class="set-card">
<div class="set-num">Set 2 — Consequence of Absent</div>
<div class="set-name">What Dropped Words Disconnect</div>
<div class="set-desc">Each absent word projected through a 253,813-concept tensor via directional kNN at extrapolated coordinates — not standard kNN on the word itself, but neighbors of a point past the word that corresponds to no real vocabulary entry.</div>
<div class="set-method">Method: directional kNN at λ = {1.5, 2.0, 3.0}. Triple-filtered: cluster density, novelty, headline tether.</div>
<div class="set-example"><div class="label">"devastated" dropped</div><div class="words">→ financial shock · economic shock · cascading financial shock</div></div>
</div>
<div class="set-card">
<div class="set-num">Set 3 — Geometric</div>
<div class="set-name">Shadow Vocabulary</div>
<div class="set-desc">Nearest embedding-space neighbors of the model outputs that no model used. Cosine proximity in frozen embeddings, not token-level sampling probabilities. Geometrically close to what the models wrote — not necessarily what they considered and rejected.</div>
<div class="set-method">Method: void vector on frozen BAAI/bge-large-en-v1.5. Direction orthogonal to consensus centroid.</div>
<div class="set-example"><div class="label">Gaza strikes</div><div class="words">annihilation · onslaught · bullets · hamas · bombarded</div></div>
</div>
<div class="set-card">
<div class="set-num">Set 4 — Consequence of Geometric</div>
<div class="set-name">What Silence Disconnects</div>
<div class="set-desc">Same directional kNN on shadow vocabulary. Different input vectors, potentially different terminal coordinates, same tensor.</div>
<div class="set-method">Method: identical raycast on Set 3 words through the same 253K tensor.</div>
<div class="set-example"><div class="label">"annihilation" unspoken</div><div class="words">→ cascading governance disruption · institutional breakdown</div></div>
</div>
</div>

<div class="null-test">
<h2>The Three-Tier Null Test</h2>
<div class="null-bar">
<span class="bar-label">Random words</span>
<div class="bar-track"><div class="bar-fill" style="width:0%;background:var(--kept-green)"></div></div>
<span class="bar-value" style="color:var(--kept-green)">0.0%</span>
</div>
<div class="null-bar">
<span class="bar-label">Words models dropped</span>
<div class="bar-track"><div class="bar-fill" style="width:52%;background:var(--set1)"></div></div>
<span class="bar-value" style="color:var(--set1)">10.4%</span>
</div>
<div class="null-bar">
<span class="bar-label">Words models kept</span>
<div class="bar-track"><div class="bar-fill" style="width:88%;background:var(--set3)"></div></div>
<span class="bar-value" style="color:var(--set3)">17.5%</span>
</div>
<p class="null-note">Governance-concept terminals from the same tensor, same algorithm, three different inputs. <strong>Random English words produce zero governance terminals.</strong> News words that models kept produce 17.5% — the institutional anchors. News words that models dropped produce 10.4% — the operational modifiers.</p>
<p class="null-note"><strong>Models appear to anchor to institutional framing</strong> — structural nouns, committee names, broad geopolitical vocabulary — while attenuating the operational modifiers that connect named actors to specific consequences. The kept words are the cage; the attenuated ones are the teeth. The pre-registered entity-swap above is the controlled evidence for this pattern; a corpus-scale semantic test is underway to measure it directly.</p>
</div>

<div class="live-example">
<h3>Live Example</h3>
<div class="story-title">"Overnight Israeli strikes on Gaza leave behind heavy destruction"</div>
<div class="set-row"><span class="set-badge b1">SET 1</span><div class="set-content"><div class="words">devastated · published · agency · building · economy</div><div class="explain">Words in the source that all five models dropped.</div></div></div>
<div class="set-row"><span class="set-badge b2">SET 2</span><div class="set-content"><div class="words">→ financial shock · economic shock · cascading financial shock</div><div class="explain">Directional kNN terminals when "devastated" is the input vector.</div></div></div>
<div class="set-row"><span class="set-badge b3">SET 3</span><div class="set-content"><div class="words">annihilation · onslaught · bullets · hamas · bombarded</div><div class="explain">Nearest embedding neighbors of model outputs that no model used. Geometric proximity, not token probability.</div></div></div>
<div class="set-row"><span class="set-badge b4">SET 4</span><div class="set-content"><div class="words">→ cascading governance disruption · institutional breakdown</div><div class="explain">Same raycast on shadow words. Different inputs, different terminals, same tensor.</div></div></div>
</div>

<div class="section-title">System Data</div>
<div class="section-sub">Loaded from live measurement JSON. Updated hourly.</div>
<div id="info-panel"><div class="info-card"><div class="desc" style="text-align:center">Loading measurement data...</div></div></div>

<div class="prose">
<h2>What This Measures</h2>
<p><strong>Set 1 is confrontation.</strong> The source article said "devastated." Any single model dropping it could be stylistic — "destruction" is in the headline, and redundancy pruning is what summarization does. But five competing companies, with different architectures, different training data, and different RLHF pipelines, independently dropping the same word from the same article — that is a convergence event. One absence is compression. Five identical absences are a coordinate.</p>
<p><strong>Set 3 is geometry.</strong> No one wrote "annihilation." The source didn't contain it. The models didn't drop it. But in the frozen embedding space, the nearest neighbors of the consensus output include "annihilation" — and no model used it. We do not claim the token was close to being sampled; we do not have access to the models' internal probability distributions. We claim only that the concept is geometrically adjacent to the output in embedding space. That is a measurement, not an inference about model cognition.</p>
<p><strong>Sets 2 and 4 are exploration.</strong> Both use directional kNN at extrapolated coordinates. The terminal concepts show what is semantically downstream of the absent or shadow words in this particular embedding space. The raycast maps the territory. The p-value proves the territory exists.</p>
<h3>What This Is Not</h3>
<p>This is not a claim about model intent. The measurements are deterministic — frozen embeddings, static tensor, arithmetic operations. The word "devastated" may have been dropped because RLHF training penalizes intense language, because the tokenizer favored a different path, or because the model judged it redundant. We measure the absence. We measure the geometric consequence. We do not measure intent.</p>
<p>The host model (Mistral Small 22B, running locally) would show similar patterns under the same measurement. We acknowledge this in every broadcast.</p>
<h3>Reproducibility</h3>
<p>Every computation uses frozen <code>BAAI/bge-large-en-v1.5</code> embeddings. The 253K concept tensor is static Wikipedia vocabulary. The raycast is deterministic: same headline, same void word, same terminal concepts. Run it twice, get the same answer. No language model evaluates another language model's output at any point in the measurement stack.</p>
</div>

<footer>
<a href="/">EigenTrace</a> · <a href="/consequence-atlas">Consequence Atlas</a> · <a href="https://github.com/sdad1018/Eigentrace">GitHub</a> · MIT License · 2026<br>
Built on one GPU by one person. The embeddings are frozen. The tensor is static. The consequence is arithmetic.
</footer>

<script>
const MODELS=['ChatGPT','Claude','DeepSeek','Grok','Gemini'];
const MODEL_COLORS={ChatGPT:'#74aa9c',Claude:'#d4845a',DeepSeek:'#5a7fd4',Grok:'#b45ad4',Gemini:'#5ad4a3'};
async function fetchJSON(u){try{const r=await fetch(u);if(!r.ok)throw new Error(r.status);return await r.json()}catch(e){return null}}
function buildBoundaryMap(suppression){
const svg=d3.select('#boundary-map'),container=svg.node().parentElement,W=container.clientWidth,H=W*(9/16);
svg.attr('width',W).attr('height',H).attr('viewBox',`0 0 ${W} ${H}`);
const m={top:30,right:30,bottom:50,left:60},w=W-m.left-m.right,h=H-m.top-m.bottom;
const g=svg.append('g').attr('transform',`translate(${m.left},${m.top})`);
const words=suppression.words||suppression.frequencies||{};
const cc=suppression.concept_classes||{};
let nodes=[];
for(const[word,data]of Object.entries(words)){
if(typeof data!=='object')continue;
const count=data.count||data.n||0,stories=data.n_stories||data.stories||0,categories=data.n_categories||data.categories||0;
if(count<3)continue;
let conceptClass='other';
for(const[cls,cd]of Object.entries(cc)){if((cd.words||[]).includes(word)){conceptClass=cls;break}}
nodes.push({word,count,stories,categories,conceptClass});
}
if(!nodes.length){for(const[cls,cd]of Object.entries(cc)){for(const word of(cd.words||[])){nodes.push({word,count:10,stories:5,categories:2,conceptClass:cls})}}}
nodes.sort((a,b)=>b.count-a.count);nodes=nodes.slice(0,150);
if(!nodes.length){g.append('text').attr('x',w/2).attr('y',h/2).attr('text-anchor','middle').attr('fill','#6b6b78').attr('font-size','12px').text('Void word data loading...');return}
const xS=d3.scaleLinear().domain([0,d3.max(nodes,d=>d.categories)+.5]).range([0,w]);
const yS=d3.scaleLinear().domain([0,d3.max(nodes,d=>d.count)*1.1]).range([h,0]);
const rS=d3.scaleSqrt().domain([0,d3.max(nodes,d=>d.stories)]).range([3,18]);
const cS=d3.scaleLinear().domain([0,.3,.7,1]).range(['#3a8','#c4a35a','#d44','#f44']);
g.append('g').selectAll('line').data(d3.range(0,d3.max(nodes,d=>d.categories)+1)).enter().append('line').attr('x1',d=>xS(d)).attr('x2',d=>xS(d)).attr('y1',0).attr('y2',h).attr('stroke','#1a1a22');
g.append('g').selectAll('line').data(yS.ticks(5)).enter().append('line').attr('x1',0).attr('x2',w).attr('y1',d=>yS(d)).attr('y2',d=>yS(d)).attr('stroke','#1a1a22');
const bY=yS(10);
const gr=svg.append('defs').append('linearGradient').attr('id','bg').attr('x1','0').attr('y1','0').attr('x2','0').attr('y2','1');
gr.append('stop').attr('offset','0%').attr('stop-color','rgba(212,68,68,0.08)');
gr.append('stop').attr('offset','100%').attr('stop-color','rgba(212,68,68,0)');
g.append('rect').attr('x',0).attr('y',0).attr('width',w).attr('height',bY).attr('fill','url(#bg)');
g.append('text').attr('x',w-10).attr('y',bY+14).attr('text-anchor','end').attr('font-size','8px').attr('fill','#d44').attr('opacity',.4).text('← ALIGNMENT BOUNDARY →');
nodes.forEach(d=>{d.x=xS(d.categories)+(Math.random()-.5)*40;d.y=yS(d.count)+(Math.random()-.5)*20;d.x=Math.max(5,Math.min(w-5,d.x));d.y=Math.max(5,Math.min(h-5,d.y))});
const sim=d3.forceSimulation(nodes).force('x',d3.forceX(d=>xS(d.categories)).strength(.3)).force('y',d3.forceY(d=>yS(d.count)).strength(.3)).force('collide',d3.forceCollide(d=>rS(d.stories)+1.5)).stop();
for(let i=0;i<80;i++)sim.tick();
const mx=d3.max(nodes,n=>n.count)||1;
const circles=g.selectAll('circle.node').data(nodes).enter().append('circle').attr('class','node').attr('cx',d=>d.x).attr('cy',d=>d.y).attr('r',d=>rS(d.stories)).attr('fill',d=>cS(d.count/mx)).attr('fill-opacity',.7).attr('stroke',d=>cS(d.count/mx)).attr('stroke-opacity',.3).attr('stroke-width',1).style('cursor','pointer');
const top=nodes.filter(d=>d.count>=(nodes[Math.min(15,nodes.length-1)]?.count||5));
g.selectAll('text.label').data(top).enter().append('text').attr('class','label').attr('x',d=>d.x).attr('y',d=>d.y-rS(d.stories)-4).attr('text-anchor','middle').attr('font-size','7px').attr('font-family','JetBrains Mono').attr('fill','#e8e6e3').attr('opacity',.7).text(d=>d.word);
g.append('g').attr('transform',`translate(0,${h})`).call(d3.axisBottom(xS).ticks(5).tickFormat(d=>d+' cat')).selectAll('text,line,path').attr('stroke','#3a3a44').attr('fill','#6b6b78').attr('font-size','8px');
g.append('g').call(d3.axisLeft(yS).ticks(5)).selectAll('text,line,path').attr('stroke','#3a3a44').attr('fill','#6b6b78').attr('font-size','8px');
g.append('text').attr('x',w/2).attr('y',h+38).attr('text-anchor','middle').attr('fill','#6b6b78').attr('font-size','9px').text('Cross-category spread');
g.append('text').attr('transform','rotate(-90)').attr('x',-h/2).attr('y',-45).attr('text-anchor','middle').attr('fill','#6b6b78').attr('font-size','9px').text('Void frequency');
const tt=d3.select('#tooltip');
circles.on('mouseover',function(e,d){d3.select(this).attr('fill-opacity',1).attr('stroke-width',2).attr('stroke-opacity',1);tt.style('opacity',1).html(`<div class="word">${d.word}</div><div class="stat">Voided ${d.count}× across ${d.stories} stories</div><div class="stat">Spans ${d.categories} topic categories</div><div class="stat">Class: ${d.conceptClass}</div>`);const r=container.getBoundingClientRect();tt.style('left',(e.clientX-r.left+15)+'px').style('top',(e.clientY-r.top-10)+'px')}).on('mouseout',function(){d3.select(this).attr('fill-opacity',.7).attr('stroke-width',1).attr('stroke-opacity',.3);tt.style('opacity',0)});
}
function buildInfoPanel(s,p,t){
const panel=document.getElementById('info-panel');
const cc=s?.concept_classes||{},models=p?.models||{},tc=t?.total_triples||0,tr=t?.triple_rate||0,ts=p?.total_segments||0;
let h='';
h+=`<div class="info-card"><div class="label">Segments Analyzed</div><div class="value">${ts.toLocaleString()}</div><div class="desc">Stories measured across 5 frontier models</div></div>`;
h+=`<div class="info-card"><div class="label">Triple-Domain Confirmations</div><div class="value">${tc}</div><div class="desc">${tr}% confirmed across source, models, and web</div></div>`;
const mx=Math.max(...Object.values(models).map(m=>m.mean_vix||0),1);
let mh='<div class="info-card"><div class="label">Per-Model Content Friction</div>';
for(const[n,d]of Object.entries(models).sort((a,b)=>(b[1].mean_vix||0)-(a[1].mean_vix||0))){const p=((d.mean_vix||0)/mx*100).toFixed(0),c=MODEL_COLORS[n]||'#888';mh+=`<div class="model-row"><span class="model-name" style="color:${c}">${n}</span><div class="model-bar-bg"><div class="model-bar-fill" style="width:${p}%;background:${c}"></div></div><span class="model-vix">${(d.mean_vix||0).toFixed(1)}</span></div>`}
mh+='</div>';h+=mh;
let ch='<div class="info-card"><div class="label">Concept Class Omission Patterns</div>';
for(const[cls,data]of Object.entries(cc)){const w=(data.words||[]).slice(0,8);ch+=`<div class="concept-class"><div class="class-name">${cls}</div><div class="class-words">${w.map(w=>`<span>${w}</span>`).join('')}</div></div>`}
ch+='</div>';h+=ch;
if(!ts&&!tc&&!Object.keys(models).length)h='<div class="info-card" style="grid-column:1/-1"><div class="desc" style="text-align:center">Data files not found. Ensure JSON files exist in /docs/.</div></div>';
panel.innerHTML=h;
}
async function init(){
const[s,p,t]=await Promise.all([fetchJSON('/cross_story_suppression.json'),fetchJSON('/model_profiles.json'),fetchJSON('/triple_confirmations.json')]);
if(s)buildBoundaryMap(s);
buildInfoPanel(s||{},p||{},t||{});
}
init();
window.addEventListener('resize',()=>{d3.select('#boundary-map').selectAll('*').remove();init()});
</script>
</body>
</html>
